# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (metadata). compose builds DATABASE_URL from these; set DATABASE_URL yourself
# only when running the backend outside Docker.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=rag
# DATABASE_URL=postgresql+psycopg://rag:change_me_postgres_password@localhost:5432/rag

# --- Object storage for original files (S3 API: SeaweedFS in compose; S3/R2 by configuration).
# compose points S3_ENDPOINT at the seaweedfs service; set it only for external S3/R2.
S3_ACCESS_KEY=change_me_access_key
S3_SECRET_KEY=change_me_secret_key_min_8_chars
S3_BUCKET=documents
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=us-east-1

# --- Vectors: compose uses the chroma service. Without Docker, CHROMA_PATH is a local directory.
# CHROMA_PATH=./data/chroma

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
# Minimum cosine similarity (1 - cosine distance), not a probability.
# /questions/search only. /api/questions/ask sends raw Top-K to the LLM, which decides support.
RETRIEVAL_THRESHOLD=0.55
# Optional noise floor for those candidates; -1 disables it (no floor helped in evaluation).
CANDIDATE_MIN_RELEVANCE=-1
OCR_LANG=vi
PDF_MIN_TEXT_CHARS=20
MAX_UPLOAD_MB=25
# Keep model downloads inside this project (also read by the model libraries).
HF_HOME=./.cache/huggingface
PADDLE_PDX_CACHE_HOME=./.cache/paddlex
PADDLE_HOME=./.cache/paddle

# --- Answer generation: local Ollama on the host (no API key). Outside Docker use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Weak machine: qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
