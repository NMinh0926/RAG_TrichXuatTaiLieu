# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (metadata). The app builds its database URL from these (host: the compose postgres service).
# Set POSTGRES_PASSWORD BEFORE the first `docker compose up`: PostgreSQL stores it only when the pg_data volume
# is created. To change it later, first run (with the stack up)
#   docker compose exec postgres psql -U rag -d rag -c "ALTER USER rag PASSWORD '<new>'"
# then put the new value here and run `docker compose up -d`.
# Any characters work except $ (compose interpolation), quotes and spaces; e.g. `openssl rand -hex 32` or
# PowerShell [guid]::NewGuid().ToString('N').
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=rag
# External/managed PostgreSQL: set its host and port (the containers build the URL from these parts).
# POSTGRES_HOST=db.example.internal
# POSTGRES_PORT=5432
# DATABASE_URL is only for running the backend outside Docker; the containers ignore it.
# DATABASE_URL=postgresql+psycopg://rag:<password>@localhost:5432/rag

# --- Object storage for original files (S3 API: SeaweedFS in compose; S3/R2 by configuration).
# Unset = the compose seaweedfs service; set S3_ENDPOINT (and S3_REGION) for external S3/R2.
S3_ACCESS_KEY=change_me_access_key
S3_SECRET_KEY=change_me_secret_key_min_8_chars
S3_BUCKET=documents
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=us-east-1

# --- Vectors: unset = the compose chroma service; set CHROMA_HOST/CHROMA_PORT for another Chroma server.
# CHROMA_HOST=chroma.example.internal
# CHROMA_PORT=8000

# --- Ingest queue (RQ on Redis): unset = the compose redis service.
# REDIS_URL=redis://<host>:6379/0
# A job running longer than this is stopped (3600 s ~ 2,900 text-PDF pages on the measured machine, see
# docs/benchmarks/report.md).
INGEST_JOB_TIMEOUT_SECONDS=3600
# Legacy synchronous upload (/documents/upload) waits at most this long for its ingest job.
INGEST_WAIT_SECONDS=1800

# Retrieval (see docs/benchmarks/stage2.md). Changing these needs: python -m scripts.reindex
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# Chunks sent to the LLM. Optional cross-encoder: RETRIEVAL_CANDIDATES are reranked down to TOP_K
# (BAAI/bge-reranker-v2-m3 improved hit rate but costs 7-30 s per question on CPU; off by default).
TOP_K=6
RETRIEVAL_CANDIDATES=20
RERANKER_MODEL=
# Minimum cosine similarity (1 - cosine distance), not a probability.
# /questions/search only. /api/questions/ask sends raw Top-K to the LLM, which decides support.
RETRIEVAL_THRESHOLD=0.55
# Optional noise floor for those candidates; -1 disables it (no floor helped in evaluation).
CANDIDATE_MIN_RELEVANCE=-1
OCR_LANG=vi
PDF_MIN_TEXT_CHARS=20
# Upload limits from docs/benchmarks/report.md. Ingest time grows with pages; keep nginx's
# client_max_body_size (frontend/nginx.conf) a little above MAX_UPLOAD_MB.
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=300
# Keep model downloads inside this project (also read by the model libraries).
HF_HOME=./.cache/huggingface
# Parallel OCR processes per document (Tesseract, one CPU thread each).
OCR_WORKERS=4

# --- Answer generation: any OpenAI-compatible API (/v1/chat/completions). Default: Ollama on the host.
# Outside Docker use http://localhost:11434/v1. For a hosted API set its URL and LLM_API_KEY.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
# Weak machine: qwen2.5:3b
LLM_MODEL=qwen2.5:7b
# Optional smaller model for the per-section (map) step of whole-document summaries, e.g. qwen2.5:3b
# (about 40% faster summaries, docs/benchmarks/stage2.md). Empty = LLM_MODEL. Must be pulled too; /health/llm
# reports it as summary_model_available.
LLM_SUMMARY_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
# Must match the server's context window (Ollama: set OLLAMA_CONTEXT_LENGTH=8192 on the host).
LLM_CONTEXT_TOKENS=8192
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Accounts and sessions. Accounts are created by an admin; there is no sign-up.
# First admin: created by the init service only while no account exists (remove afterwards), or run
#   docker compose run --rm -it api python -m scripts.create_user <name> --admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# Session token signing key (>= 32 chars). Empty: the init service generates one into a Docker volume.
# Changing it signs everyone out.
AUTH_SECRET=
SESSION_HOURS=12
# true when the site is served over HTTPS (cookie is then never sent over plain HTTP).
COOKIE_SECURE=false
# Per user (login: per IP and per username) per minute; 0 disables.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- Logs: one JSON object per line (json) or plain text (text).
LOG_FORMAT=json

# --- Web UI address. 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the office network.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
