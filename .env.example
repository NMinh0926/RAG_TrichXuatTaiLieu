# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (metadata). compose builds DATABASE_URL from these; set DATABASE_URL yourself
# only when running the backend outside Docker.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=rag
# DATABASE_URL=postgresql+psycopg://rag:change_me_postgres_password@localhost:5432/rag

# --- Object storage for original files (S3 API: SeaweedFS in compose; S3/R2 by configuration).
# compose points S3_ENDPOINT at the seaweedfs service; set it only for external S3/R2.
S3_ACCESS_KEY=change_me_access_key
S3_SECRET_KEY=change_me_secret_key_min_8_chars
S3_BUCKET=documents
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=us-east-1

# --- Vectors: compose uses the chroma service. Without Docker, CHROMA_PATH is a local directory.
# CHROMA_PATH=./data/chroma

# Retrieval (see docs/benchmarks/stage2.md). Changing these needs: python -m scripts.reindex
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# Chunks sent to the LLM. Optional cross-encoder: RETRIEVAL_CANDIDATES are reranked down to TOP_K
# (BAAI/bge-reranker-v2-m3 improved hit rate but costs 7-30 s per question on CPU; off by default).
TOP_K=6
RETRIEVAL_CANDIDATES=20
RERANKER_MODEL=
# Minimum cosine similarity (1 - cosine distance), not a probability.
# /questions/search only. /api/questions/ask sends raw Top-K to the LLM, which decides support.
RETRIEVAL_THRESHOLD=0.55
# Optional noise floor for those candidates; -1 disables it (no floor helped in evaluation).
CANDIDATE_MIN_RELEVANCE=-1
OCR_LANG=vi
PDF_MIN_TEXT_CHARS=20
MAX_UPLOAD_MB=25
# Keep model downloads inside this project (also read by the model libraries).
HF_HOME=./.cache/huggingface
# Parallel OCR processes per document (Tesseract, one CPU thread each).
OCR_WORKERS=4

# --- Answer generation: any OpenAI-compatible API (/v1/chat/completions). Default: Ollama on the host.
# Outside Docker use http://localhost:11434/v1. For a hosted API set its URL and LLM_API_KEY.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
# Weak machine: qwen2.5:3b
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
# Must match the server's context window (Ollama: set OLLAMA_CONTEXT_LENGTH=8192 on the host).
LLM_CONTEXT_TOKENS=8192
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
